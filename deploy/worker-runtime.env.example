APP_ENV=production
LOG_LEVEL=INFO
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_API_KEYS=primary:your-first-key,backup1:your-second-key,backup2:your-third-key
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOW_LIVE_TRADING=false
POLL_INTERVAL_SECONDS=60
CANDLE_LIMIT=300
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5
LIVE_FEE_RATE=0.001
LIVE_SLIPPAGE_BPS=5
ESTIMATED_SPREAD_BPS=2
MIN_PROFIT_BUFFER_BPS=8
MIN_EXPECTED_MOVE_BPS=18
MIN_VOLUME_RATIO=1.15
MAX_ENTRY_ATR_BPS=220
MIN_REWARD_RISK=1.8
MAX_HOLD_MINUTES=45
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_LIMIT=50
GEMINI_MINUTE_REQUEST_LIMIT=10
GEMINI_DAILY_TOKEN_LIMIT=0
GEMINI_TOKEN_MINUTE_LIMIT=0
GEMINI_RATE_LIMIT_COOLDOWN_MINUTES=60
